# =============================================================================
# Gitignore for AI-Based Assignment Plagiarism Detector
# =============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.env
*.pem
*.key
gcp-key.json
*credential*.json
*secret*.json
!**/.env.example

# --- Python & Bytecode ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
env.bak/
venv.bak/

# --- Databases & SQLite Local Stores ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
plagiarism.db
backend/plagiarism.db

# --- Heavy ML Model Weights & Large Checkpoints (>100MB) ---
# GitHub rejects files > 100MB. Heavy fine-tuned weights must be kept local.
backend/models/trocr_finetuned/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.h5

# --- OCR Generated Datasets & Uploads ---
backend/uploads/*
!backend/uploads/.gitkeep
backend/ocr_dataset/

# --- Data Pipeline Intermediate Outputs ---
backend/data_pipeline/output/*.csv
backend/data_pipeline/output/*.pkl
!backend/services/ml_services/*.pkl
!backend/services/ml_services/*.json

# --- Node & Frontend Builds ---
node_modules/
dist/
dist-ssr/
.dist/
backend/.dist/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Code Quality Artifacts ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# --- IDEs & Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Temporary & Scratch Test Artifacts ---
temp_ocr_test/
temp_*
temp_processed_ocr.jpg
Scan document*.pdf
backend/_test_*
backend/dummy_test.txt
backend/test_upload.txt
backend/test_image_1.jpg
backend/test_image_2.jpg

# --- Scan Output Artifacts & Test Dumps ---
ai_detection_scan_report.json
colab_scan_report.json
colab_extracted_text.txt
ocr_pipeline_extracted.json
page*_got_output.txt
page*_output.txt
*_scan_report.json
*_extracted_text.txt
*_extracted.json
*.scan.json

# --- PyTorch / HuggingFace Training Checkpoints & Model Caches ---
checkpoint-*/
**/checkpoint-*/
runs/
wandb/
*.ckpt
*.tflite
*.joblib
*.weights
hf_cache/
torch_cache/
.cache/
**/.cache/

# --- Local Databases, SQL Dumps & Backups ---
*.sql
*.sql.gz
*.dump
backup/
backups/

# --- General Logs & Python Outputs ---
*.log
backend/*.log
logs/
backend/logs/

# --- Archives & Zips (Prevent committing Drive backup archives) ---
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- Code Quality & Environment Caches ---
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.eslintcache/


