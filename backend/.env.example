# ==============================================================================
# Plagiarism AI — Secure Authentication & Session Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection
# ------------------------------------------------------------------------------
# MySQL connection string format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:12345678@localhost:3306/plagiarism_db

# ------------------------------------------------------------------------------
# 2. Session & Cookie Security
# ------------------------------------------------------------------------------
# Cryptographic secret used for session and CSRF signature verification.
# In production, generate a high-entropy secret using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change_this_to_a_high_entropy_random_secret_in_production_key_32bytes_min

# Cookie attribute settings:
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_PATH=/
# Set COOKIE_SECURE=True in production (requires HTTPS)
COOKIE_SECURE=False
# Options: lax, strict, none (lax recommended for browser navigation compatibility)
COOKIE_SAMESITE=lax

# Session Expiration & Lifetime:
# Inactivity timeout (seconds): 30 minutes = 1800
SESSION_IDLE_TIMEOUT=1800
# Absolute session lifetime (seconds): 7 days = 604800
SESSION_MAX_AGE=604800

# ------------------------------------------------------------------------------
# 3. CORS & Trusted Origins
# ------------------------------------------------------------------------------
# Comma-separated list of trusted client origins permitted to receive credentials.
# Do NOT use '*' when allow_credentials=True.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Rate Limiting & Brute-Force Defenses
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

RATE_LIMIT_REGISTER_MAX_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300

RATE_LIMIT_RESET_MAX_REQUESTS=5
RATE_LIMIT_RESET_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Email & SMTP Configuration (Password Reset & Verification)
# ------------------------------------------------------------------------------
# If credentials are not provided, tokens and links will be logged to server console
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@plagiarismai.edu
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Production-Grade Password Reset Security
# ------------------------------------------------------------------------------
# Reset token lifetime in minutes (recommended: 15–30)
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=20

# Multi-dimensional rate limiting for forgot-password and reset-password
PASSWORD_RESET_RATE_LIMIT_IP=5
PASSWORD_RESET_RATE_LIMIT_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_WINDOW=900

# Risk-based OTP verification lifetime in minutes (if challenged)
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_OTP_ATTEMPTS=5

# Send email security notification to user upon password change
SECURITY_NOTIFICATION_ENABLED=True

# ------------------------------------------------------------------------------
# 7. Admin — Default User Password
# ------------------------------------------------------------------------------
# Default password assigned to users created or reset by an Admin.
# Must satisfy the password policy (min 8 chars, letters + numbers).
DEFAULT_USER_PASSWORD=Welcome@123
