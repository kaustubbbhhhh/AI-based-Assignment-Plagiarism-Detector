# =============================================================================
# Environment Variables Example for AI-Based Assignment Plagiarism Detector
# =============================================================================
# Copy this file to `.env` in the `backend/` directory and fill in your values.

# ── Database Connection ───────────────────────────────────────────────────────
# MySQL (Recommended for local dev / staging)
DATABASE_URL=mysql://root:password@localhost:3306/plagiarism_db

# PostgreSQL (Alternative production option)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/plagiarism_db

# SQLite (Fallback lightweight local dev)
# DATABASE_URL=sqlite:///./plagiarism.db

# ── Redis / Celery Task Queue ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication & Security ─────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── SMTP Email Service (Password Reset Flow) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME="PlagiarismAI Support"
FRONTEND_URL=http://localhost:5173

# ── Google Cloud Vision OCR (Optional Fallback) ───────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

